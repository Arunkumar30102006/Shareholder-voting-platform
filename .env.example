# Frontend Environment Variables (Safe for client bundle)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Backend Secrets (Set ONLY in Supabase / Serverless environment via `supabase secrets set`)
# DO NOT put these in frontend .env files or prefix with VITE_
# RESEND_API_KEY="re_..."
# GROQ_API_KEY="gsk_..."
# OTP_HMAC_SECRET="your-64-char-hex-hmac-secret"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
